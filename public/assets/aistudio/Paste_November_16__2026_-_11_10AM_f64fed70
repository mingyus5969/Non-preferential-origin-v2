        }

        // 태그 필터 변경 함수
        function setTagFilter(tag) {
            activeTag = tag;
            ['all', 'I', 'II', 'III'].forEach(t => {
                const btn = document.getElementById(`tag-${t}`);
                if (t === tag) {
                    btn.className = "px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-brand-navy text-white transition-premium";
                } else {
                    btn.className = "px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-white border border-slate-200 text-slate-600 hover:text-brand-cyan transition-premium";
                }
            });
            filterCases();
        }

        // 사례 목록 동적 랜더링 및 필터링
        function filterCases() {
            const query = document.getElementById('case-search').value.toLowerCase().trim();
            const container = document.getElementById('case-list-container');
            container.innerHTML = '';

            const filtered = CASES_DATABASE.filter(c => {
                const matchTag = (activeTag === 'all' || c.tag === activeTag);
                const matchQuery = (!query || c.title.toLowerCase().includes(query) || c.query.toLowerCase().includes(query) || c.reply.toLowerCase().includes(query));
                return matchTag && matchQuery;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 bg-white rounded-2xl border border-slate-100 premium-shadow">
                        <i class="fa-solid fa-folder-open text-slate-300 text-4xl mb-3 block"></i>
                        <span class="text-xs text-slate-500 font-light">검색 조건에 부합하는 질의회신 사례 데이터가 없습니다.</span>
                    </div>`;
                return;
            }

            filtered.forEach(c => {
                const isI = c.tag === 'I';
                const isII = c.tag === 'II';
                const badgeColor = isI ? 'bg-brand-cyan/10 text-brand-cyan border-brand-cyan/20' : (isII ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-amber-50 text-amber-700 border-amber-100');
                
                const item = document.createElement('div');
                item.className = "bg-white rounded-2xl border border-slate-100 premium-shadow overflow-hidden transition-premium";
                item.innerHTML = `
                    <!-- 아코디언 헤더 -->
                    <div onclick="toggleAccordion('case-body-${c.num}')" class="flex justify-between items-center p-5 cursor-pointer hover:bg-slate-50/50 transition-premium select-none">
                        <div class="flex items-center space-x-3 pr-4">
                            <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-bold border ${badgeColor}">${c.type}</span>
                            <h4 class="text-xs font-bold text-slate-900 leading-snug">${c.title}</h4>
                        </div>
                        <div class="flex items-center space-x-2 text-slate-400">
                            <span class="text-[10px] font-mono font-semibold">${c.year}년</span>
                            <i id="icon-case-body-${c.num}" class="fa-solid fa-chevron-down transition-transform duration-300"></i>
                        </div>
                    </div>
                    <!-- 아코디언 바디 (기본 히든) -->
                    <div id="case-body-${c.num}" class="hidden border-t border-slate-100 bg-slate-50/50 p-6 space-y-4 text-xs">
                        <div class="space-y-1.5">
                            <span class="font-bold text-brand-navy block"><i class="fa-regular fa-comments mr-1 text-brand-cyan"></i> 민원인 질의 내용:</span>
                            <p class="text-slate-600 font-light leading-relaxed bg-white p-4 rounded-xl border border-slate-200/60">${c.query}</p>
                        </div>
                        <div class="space-y-1.5">
                            <span class="font-bold text-emerald-700 block"><i class="fa-solid fa-circle-check mr-1 text-emerald-500"></i> 유효 행정 회신 내용:</span>
                            <p class="text-slate-600 font-light leading-relaxed bg-white p-4 rounded-xl border border-slate-200/60">${c.reply}</p>
                        </div>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        // 아코디언 토글 제어 함수
        function toggleAccordion(id) {
            const el = document.getElementById(id);
            const icon = document.getElementById(`icon-${id}`);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                el.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // 가상 백오피스 방문자 카운트 시뮬레이션
        let currentVisitors = 1482;
        setInterval(() => {
            currentVisitors += Math.floor(Math.random() * 3) + 1;
            document.getElementById('admin-visitors').innerText = `${currentVisitors.toLocaleString()} 명`;
        }, 8000);

        // 최초 렌더링 가동
        window.onload = function() {
            filterCases();
        };
    </script>
