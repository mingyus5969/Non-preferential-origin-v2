    <!-- 2. 판정기준 섹션 -->
    <section id="criteria" class="py-16 bg-slate-100/60 border-t border-b border-slate-200 scroll-mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center space-x-2 text-brand-cyan font-bold text-xs tracking-wider mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan"></span>
                <span>SECTION 02</span>
            </div>
            <h2 class="text-3xl font-extrabold text-brand-navy tracking-tight mb-4">비특혜 원산지 판정기준 및 절차도</h2>
            <p class="text-sm text-slate-500 max-w-3xl mb-10 font-light leading-relaxed">
                관계 중앙행정기관과의 협의 하에 고시되는 정밀한 4단계 비특혜 판정 가이드라인입니다. 2개국 이상에서 가공된 물품의 한국산 및 해외 가공국 인정 여부를 체계적으로 판별합니다.
            </p>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- 왼쪽: 시각화된 원산지 판정 절차도 (Flowchart) -->
                <div class="lg:col-span-7 bg-white rounded-2xl p-8 border border-slate-100 premium-shadow">
                    <h3 class="text-lg font-bold text-brand-navy mb-6 flex items-center border-b border-slate-100 pb-3">
                        <i class="fa-solid fa-diagram-project text-brand-cyan mr-2.5"></i> 비특혜 원산지 판정 길라잡이 (절차도)
                    </h3>
                    
                    <!-- 절차 흐름도 UI (순서도 시각화) -->
                    <div class="space-y-6 relative pl-4 border-l-2 border-slate-200">
                        <!-- Step 1 -->
                        <div class="relative">
                            <div class="absolute -left-[25px] top-0 w-4 h-4 bg-brand-navy rounded-full border-4 border-white flex items-center justify-center"></div>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/60">
                                <div class="flex justify-between items-center mb-1">
                                    <span class="text-xs font-bold text-brand-cyan uppercase">Step 1</span>
                                    <span class="text-[10px] text-slate-500 font-medium">대외무역관리규정 별표 9</span>
                                </div>
                                <h4 class="text-sm font-bold text-slate-900 mb-1">특정 수입 물품 해당 여부 확인</h4>
                                <p class="text-xs text-slate-500 font-light leading-relaxed">
                                    우선적으로 [별표 9]의 농가축 사육 기간, 의류 봉제공정 등 개별 특정 기준 품목인지 확인하여 대상 시 특별 고시 기준을 최우선 매칭합니다.
                                </p>
                            </div>
                        </div>

                        <!-- Step 2 -->
                        <div class="relative">
                            <div class="absolute -left-[25px] top-0 w-4 h-4 bg-brand-navy rounded-full border-4 border-white flex items-center justify-center"></div>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/60">
                                <div class="flex justify-between items-center mb-1">
                                    <span class="text-xs font-bold text-brand-cyan uppercase">Step 2</span>
                                    <span class="text-[10px] text-slate-500 font-medium">CTSH 원칙</span>
                                </div>
                                <h4 class="text-sm font-bold text-slate-900 mb-1">HS 6단위 세번변경여부(CTSH) 검토</h4>
                                <p class="text-xs text-slate-500 font-light leading-relaxed">
                                    완제품과 수입 원재료 간의 품목번호(HS) 6단위의 코드가 다르게 변형되었는지 대조하여 실질적 변형 여부를 1차 간주합니다.
                                </p>
                            </div>
                        </div>

                        <!-- Step 3 -->
                        <div class="relative">
                            <div class="absolute -left-[25px] top-0 w-4 h-4 bg-brand-navy rounded-full border-4 border-white flex items-center justify-center"></div>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/60">
                                <div class="flex justify-between items-center mb-1">
                                    <span class="text-xs font-bold text-brand-cyan uppercase">Step 3</span>
                                    <span class="text-[10px] text-slate-500 font-medium">제85조 제8항</span>
                                </div>
                                <h4 class="text-sm font-bold text-slate-900 mb-1">국내 공정의 단순가공 여부 판단</h4>
                                <p class="text-xs text-slate-500 font-light leading-relaxed">
                                    세번이 변경되었더라도 수행한 공정이 단순 조립, 분할, 재포장, 라벨수정 등 단순가공에 불과하면 원산지 변경을 승인하지 않습니다.
                                </p>
                            </div>
                        </div>

                        <!-- Step 4 -->
